{
  "Jwt": {
    "Key" : "THIS_IS_A_DEVELOPMENT_KEY_CHANGE_IT_TO_A_LONG_RANDOM_SECRET",
    "Issuer" : "LibraryManagementApi",
    "Audience" : "LibraryManagementClient",
    "ExpiryMinutes" : 60
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "Greenleaf Library",
    "TimeoutSeconds": 15,
    "EnableTestEndpoint": false
  },

  "PasswordReset": {
    "TokenLifetimeMinutes": 15,
    "FrontendResetUrl": "",
    "ResendCooldownSeconds": 60,
    "RequestsPerWindow": 5,
    "RateLimitWindowMinutes": 15
  },

  "Borrowing": {
    "LoanPeriodDays": 14,
    "FinePerDay": 5,
    "DueSoonDays": 2,
    "TimeZoneId": "Asia/Kolkata"
  },

  "ForwardedHeaders": {
    "KnownProxies": []
  },

  "Logging" : 
  {
    "LogLevel" : 
    {
      "Default" : "Information",
      "Microsoft.AspNetCore" : "Warning"
    }
  },

  "AllowedHosts" : "*"
}
